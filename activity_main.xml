<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121721"
    android:padding="24dp">

    <!-- Topo Smart Hub -->
    <TextView
        android:id="@+id/txtHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Smart Hub"
        android:textColor="#00BFFF"
        android:textSize="28sp"
        android:textStyle="bold" />

    <!-- Painel Principal (Simulação do "On TV" / Pluto TV) -->
    <LinearLayout
        android:id="@+id/panelOnTV"
        android:layout_width="match_parent"
        android:layout_height="260dp"
        android:layout_below="@id/txtHeader"
        android:layout_marginTop="16dp"
        android:background="#1E2638"
        android:focusable="true"
        android:clickable="true"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NA TV - PLUTO TV"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/imgPlutoBanner"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="8dp"
            android:scaleType="centerCrop"
            android:src="@android:drawable/ic_menu_slideshow" />

        <Button
            android:id="@+id/btnOpenPluto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="8dp"
            android:backgroundTint="#00BFFF"
            android:focusable="true"
            android:text="Assistir Agora"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <!-- Barra de Aplicativos (Rodapé) -->
    <LinearLayout
        android:id="@+id/appDeck"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal">

        <!-- Card App Pluto TV -->
        <LinearLayout
            android:id="@+id/btnAppPluto"
            android:layout_width="120dp"
            android:layout_height="100dp"
            android:layout_marginEnd="12dp"
            android:background="#252D40"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pluto TV"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Card Outros Apps (Exemplo) -->
        <LinearLayout
            android:id="@+id/btnAppAll"
            android:layout_width="120dp"
            android:layout_height="100dp"
            android:background="#252D40"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Meus Apps"
                android:textColor="#FFFFFF" />
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
